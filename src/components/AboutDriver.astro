---
---
<section class="py-24 bg-white relative overflow-hidden">
    <!-- Background element -->
    <div class="absolute right-0 top-0 w-1/3 h-full bg-blue-50/50 skew-x-12 translate-x-1/2 z-0 hidden lg:block mouse-parallax" data-speed="40"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            
            <!-- Car Image Column -->
            <div class="relative" data-aos="fade-right">
                <!-- Main Image Card -->
                <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white rotate-[-2deg] hover:rotate-0 transition-all duration-500 z-10 group transform-gpu" data-tilt data-tilt-max="5" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.25">
                    <img src="/images/remis-real.png" alt="Renault Logan Amarillo - Remis Jujuy" class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700">
                    
                    <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-brand-blue/90 to-transparent p-6 pt-24 text-white">
                        <span class="bg-jujuy-sun text-black text-xs font-black px-2 py-1 rounded uppercase tracking-widest">Unidad 0809</span>
                        <p class="font-bold mt-1">Renault Logan - Modelos Nuevos</p>
                    </div>
                </div>
                
                <!-- Experience Badge -->
                <div class="absolute -top-6 -left-6 bg-brand-blue text-white w-24 h-24 rounded-full flex flex-col items-center justify-center shadow-lg border-4 border-white z-30 animate-pulse-slow">
                    <span class="text-3xl font-black">30+</span>
                    <span class="text-[0.6rem] font-bold uppercase tracking-wide">Años</span>
                </div>
            </div>

            <!-- Content Column -->
            <div data-aos="fade-left">
                <span class="text-brand-light font-bold tracking-widest uppercase text-sm mb-2 block">Tu Chofer de Confianza</span>
                <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                    MÁS QUE UN VIAJE, <br>
                    <span class="text-brand-blue">SEGURIDAD TOTAL</span>
                </h2>

                <div class="prose text-gray-600 mb-8 leading-relaxed">
                    <p class="mb-4">
                        Hola, soy <strong class="text-brand-blue">Víctor Martínez</strong>. Con más de 30 años al volante, conozco cada ruta, curva y atajo de nuestra hermosa provincia.
                    </p>
                    <p>
                        Antes de ser tu remisero amigo, fui <strong class="text-gray-900">conductor de colectivos de larga distancia</strong>. Esta experiencia me dio la capacidad de manejar vehículos de gran porte y entender la responsabilidad que implica llevar vidas a bordo. Cuento con <strong class="text-gray-900">Licencia Nacional Habilitante (LINTI)</strong> para transporte de pasajeros.
                    </p>
                </div>

                <!-- Features Grid -->
                <div class="grid grid-cols-2 gap-4 mb-10">
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-blue/30 transition-colors">
                        <div class="text-white bg-green-500 p-2 rounded-full shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">Seguro Total</h4>
                            <p class="text-xs text-gray-500 leading-tight mt-1">Cobertura amplia para pasajeros y equipaje.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-blue/30 transition-colors">
                        <div class="text-white bg-brand-blue p-2 rounded-full shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">Habilitado</h4>
                            <p class="text-xs text-gray-500 leading-tight mt-1">Unidad regulada y verificada por el municipio.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-blue/30 transition-colors">
                        <div class="text-white bg-jujuy-earth p-2 rounded-full shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">Puntualidad</h4>
                            <p class="text-xs text-gray-500 leading-tight mt-1">Respetamos tu tiempo. Llegamos antes.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-blue/30 transition-colors">
                        <div class="text-black bg-jujuy-sun p-2 rounded-full shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">Experiencia</h4>
                            <p class="text-xs text-gray-500 leading-tight mt-1">Ex-chofer de larga distancia profesional.</p>
                        </div>
                    </div>
                </div>

                <a href="https://wa.me/5493884376850?text=Hola,%20vi%20tu%20sitio%20web%20hecho%20por%20Gabriel.%20Quiero%20hacer%20un%20viaje%20con%20vos." target="_blank" class="inline-flex items-center gap-3 bg-brand-blue text-white px-8 py-4 rounded-xl font-bold hover:bg-gray-900 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                    Viajar con Víctor
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </div>
        </div>
    </div>
</section>
