---
---
<section id="contacto" class="py-24 bg-brand-blue relative overflow-hidden">
    <!-- Overlay Pattern -->
    <div class="absolute inset-0 opacity-10 mouse-parallax" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;" data-speed="120"></div>
    
    <div class="max-w-5xl mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center gap-12">
        
        <!-- Text Content -->
        <div class="md:w-1/2 text-center md:text-left text-white" data-aos="fade-right">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">Empezá tu Viaje</h2>
            <p class="text-xl text-blue-100 mb-8 font-light leading-relaxed">
                Sin intermediarios ni demoras. Coordinamos directamente por WhatsApp.
                <strong class="block mt-4 text-jujuy-sun font-medium">Simple, seguro y rápido.</strong>
            </p>
            
            <div class="flex flex-col gap-4 text-blue-100">
                <div class="flex items-center gap-3 justify-center md:justify-start">
                    <img src="/images/whatsapp-icon.png" alt="WhatsApp" class="w-6 h-6 object-contain" />
                   +54 9 388 5123456
                </div>
                <div class="flex items-center gap-3 justify-center md:justify-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    victormartinez23@gmail.com
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="md:w-1/2 w-full bg-white p-8 rounded-3xl shadow-2xl" data-aos="fade-left">
            <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">Consultar Disponibilidad</h3>
            
            <form id="whatsappForm" class="space-y-4">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Tu Nombre</label>
                    <input type="text" id="name" placeholder="Ej: Juan Pérez" class="w-full bg-gray-50 border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 rounded-xl p-3 text-gray-800 outline-none transition-all" required>
                </div>
                
                <div>
                    <label for="tripType" class="block text-sm font-medium text-gray-700 mb-1">Destino de Interés</label>
                    <div class="relative">
                        <select id="tripType" class="w-full bg-gray-50 border border-gray-200 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 rounded-xl p-3 text-gray-800 outline-none transition-all appearance-none cursor-pointer">
                            <option value="" disabled selected>Seleccioná una opción...</option>
                            <option value="Traslado Local">🚕 Traslado Local (Jujuy)</option>
                            <option value="Salinas Grandes">🧂 Salinas Grandes</option>
                            <option value="Humahuaca">🌵 Humahuaca</option>
                            <option value="Purmamarca">🏔️ Purmamarca</option>
                            <option value="Cerro 7 Colores">🌈 Cerro 7 Colores</option>
                            <option value="Aeropuerto">✈️ Aeropuerto</option>
                            <option value="Otro Destino">📍 Otro Destino</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-500">
                           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                </div>

                <a href="https://wa.me/5493884376850?text=Hola,%20vi%20tu%20sitio%20web%20hecho%20por%20Gabriel.%20Quiero%20contactarme." target="_blank" class="w-full bg-green-500 text-white font-bold text-center py-4 rounded-xl hover:bg-green-600 transition-colors shadow-lg flex items-center justify-center gap-3">
                    <img src="/images/whatsapp-icon.png" alt="WhatsApp" class="w-6 h-6 object-contain" />
                    Enviar Mensaje por WhatsApp
                </a>
                <p class="text-xs text-gray-500 text-center mt-2">
                    Te responderemos a la brevedad.
                </p>
            </form>
        </div>
    </div>
</section>

<script>
    document.getElementById('whatsappForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('name') as HTMLInputElement;
        const tripInput = document.getElementById('tripType') as HTMLSelectElement;
        
        const name = nameInput.value;
        const trip = tripInput.value || "Consulta General";
        const phone = "5493884376850";
        
        const text = `Hola Víctor! Soy ${name}. Me interesa: ${trip}. ¿Me podrías pasar info?`;
        window.open(`https://wa.me/${phone}?text=${encodeURIComponent(text)}`, '_blank');
    });
</script>
