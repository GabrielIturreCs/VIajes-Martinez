---
---
<section id="como-funciona" class="py-24 bg-white font-outfit relative overflow-hidden">
    <!-- Background Decor -->
    <div class="absolute top-0 left-0 w-full h-full opacity-50 pointer-events-none">
        <div class="absolute top-[10%] left-[-5%] w-96 h-96 bg-blue-50 rounded-full mix-blend-multiply filter blur-3xl opacity-70"></div>
        <div class="absolute bottom-[10%] right-[-5%] w-96 h-96 bg-green-50 rounded-full mix-blend-multiply filter blur-3xl opacity-70"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-20" data-aos="fade-up">
            <span class="text-brand-blue font-bold tracking-widest uppercase text-xs mb-3 block">Simple y Rápido</span>
            <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 tracking-tight">
                Tu viaje en <span class="relative inline-block">
                    3 pasos
                    <svg class="absolute w-full h-3 -bottom-1 left-0 text-jujuy-sun opacity-50" viewBox="0 0 100 10" preserveAspectRatio="none">
                        <path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="8" fill="none" />
                    </svg>
                </span>
            </h2>
            <p class="text-gray-500 text-lg leading-relaxed">
                Olvidate de las aplicaciones complicadas o de esperar en la calle. <br class="hidden md:block"/>
                Un servicio personalizado, humano y directo con tu chofer.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-12 relative">
            <!-- Connecting Line (Desktop) -->
            <div class="hidden md:block absolute top-12 left-[16%] right-[16%] h-1 bg-gradient-to-r from-gray-100 via-brand-blue/20 to-gray-100 z-0"></div>

            <!-- Step 1 -->
            <div class="relative z-10 group" data-aos="fade-up" data-aos-delay="0">
                <div class="bg-white rounded-[2rem] p-8 text-center border border-gray-100 shadow-xl shadow-gray-200/50 hover:shadow-2xl hover:shadow-brand-blue/10 transition-all duration-500 h-full flex flex-col items-center">
                    <div class="w-24 h-24 bg-blue-50 rounded-full flex items-center justify-center text-brand-blue mb-8 group-hover:scale-110 transition-transform duration-500 relative animate-float">
                        <div class="absolute inset-0 bg-blue-100 rounded-full scale-0 group-hover:scale-100 transition-transform duration-500 opacity-50"></div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="relative z-10"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-jujuy-sun rounded-full flex items-center justify-center text-black font-black text-sm border-4 border-white">1</div>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">Pedí tu Viaje</h3>
                    <p class="text-gray-500 leading-relaxed text-sm">
                        Mandanos un WhatsApp con tu <strong>ubicación actual</strong> o el lugar donde querés que te busquemos.
                    </p>
                    <div class="mt-auto pt-6 w-full">
                         <div class="bg-gray-50 rounded-xl p-3 text-xs text-brand-blue font-bold flex items-center justify-center gap-2">
                            <img src="/images/whatsapp-icon.png" class="w-4 h-4 object-contain" alt="WhatsApp">
                            "Hola, necesito un remis en..."
                         </div>
                    </div>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="relative z-10 group" data-aos="fade-up" data-aos-delay="100">
                <div class="bg-white rounded-[2rem] p-8 text-center border border-gray-100 shadow-xl shadow-gray-200/50 hover:shadow-2xl hover:shadow-brand-blue/10 transition-all duration-500 h-full flex flex-col items-center relative transform md:-translate-y-4">
                    <div class="w-24 h-24 bg-green-50 rounded-full flex items-center justify-center text-green-600 mb-8 group-hover:scale-110 transition-transform duration-500 relative animate-float" style="animation-delay: 1s">
                        <div class="absolute inset-0 bg-green-100 rounded-full scale-0 group-hover:scale-100 transition-transform duration-500 opacity-50"></div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="relative z-10"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-jujuy-sun rounded-full flex items-center justify-center text-black font-black text-sm border-4 border-white">2</div>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">Confirmación</h3>
                    <p class="text-gray-500 leading-relaxed text-sm">
                        Te respondemos al instante con la <strong>tarifa exacta</strong> (sin sorpresas) y el tiempo de demora estimado.
                    </p>
                    <div class="mt-auto pt-6 w-full">
                         <div class="bg-gray-50 rounded-xl p-3 text-xs text-green-600 font-bold flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            Confirmado: $4.500 - 5 min
                         </div>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="relative z-10 group" data-aos="fade-up" data-aos-delay="200">
                <div class="bg-white rounded-[2rem] p-8 text-center border border-gray-100 shadow-xl shadow-gray-200/50 hover:shadow-2xl hover:shadow-brand-blue/10 transition-all duration-500 h-full flex flex-col items-center">
                    <div class="w-24 h-24 bg-yellow-50 rounded-full flex items-center justify-center text-yellow-600 mb-8 group-hover:scale-110 transition-transform duration-500 relative animate-float" style="animation-delay: 2s">
                         <div class="absolute inset-0 bg-yellow-100 rounded-full scale-0 group-hover:scale-100 transition-transform duration-500 opacity-50"></div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="relative z-10"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M14 17H9"/></svg>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-jujuy-sun rounded-full flex items-center justify-center text-black font-black text-sm border-4 border-white">3</div>
                    </div>
                    
                    <h3 class="text-2xl font-black text-gray-900 mb-4">Disfrutá</h3>
                    <p class="text-gray-500 leading-relaxed text-sm">
                        Esperá tranquilo en tu lugar. Te avisamos cuando llegamos. Viajá seguro, con aire acondicionado y buena música.
                    </p>
                    <div class="mt-auto pt-6 w-full">
                         <div class="bg-gray-50 rounded-xl p-3 text-xs text-gray-500 font-bold flex items-center justify-center gap-2">
                             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-yellow-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                             Viaje 5 estrellas
                         </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- CTA Box -->
        <div class="mt-20 flex justify-center" data-aos="fade-up" data-aos-delay="300">
            <div class="bg-gray-900 rounded-full p-2 pr-8 flex items-center gap-4 hover:shadow-xl hover:scale-105 transition-all cursor-pointer group" onclick="window.open('https://wa.me/5493884376850?text=Hola,%20quiero%20hacer%20un%20viaje.', '_blank')">
                <div class="bg-jujuy-sun text-black w-12 h-12 rounded-full flex items-center justify-center group-hover:rotate-12 transition-transform">
                     <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
                </div>
                <div class="text-left">
                    <span class="block text-white text-sm font-bold">¿Listo para salir?</span>
                    <span class="block text-gray-400 text-xs">Pedí tu remis ahora</span>
                </div>
            </div>
        </div>
    </div>
</section>
