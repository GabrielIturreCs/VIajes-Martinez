                <span class="text-[10px] font-bold uppercase tracking-wider">Contacto</span>
            </a>
        </li>
    </ul>
</div>

<script>
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar?.classList.add('bg-gray-900/95', 'py-4', 'backdrop-blur-lg', 'border-white/10');
            navbar?.classList.remove('bg-transparent', 'py-6', 'border-transparent');
        } else {
            navbar?.classList.add('bg-transparent', 'py-6', 'border-transparent');
            navbar?.classList.remove('bg-gray-900/95', 'py-4', 'backdrop-blur-lg', 'border-white/10');
        }
    });
</script>
