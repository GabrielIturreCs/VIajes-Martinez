        </li>
        <li>
            <a href="#destinos" class="flex flex-col items-center justify-center text-gray-400 hover:text-jujuy-sun transition-colors gap-1 group">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-y-1 transition-transform"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 5.7 7 10.7 11.7z"/></svg>
