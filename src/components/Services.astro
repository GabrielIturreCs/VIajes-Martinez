    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-[600px] h-[600px] bg-gradient-to-tr from-jujuy-sun/10 to-transparent rounded-full blur-3xl mouse-parallax" data-speed="40"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
