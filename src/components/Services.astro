    const suggestionsData: Suggestion[] = [
        { id: 'dest-salinas-grandes', title: 'Salinas Grandes', subtitle: 'Desierto blanco, Full Day', image: '/images/f22b8744f6efd8c14e56785208b8970e.jpg', type: 'destino' },
        { id: 'dest-hornocal', title: 'Hornocal', subtitle: 'Cerro de 14 Colores', image: 'https://media.staticontent.com/media/pictures/64b58162-79d1-420d-9b59-994132fa2841', type: 'destino' },
        { id: 'dest-purmamarca', title: 'Purmamarca', subtitle: 'Cerro de 7 Colores', image: '/images/3563aa00ac3286404b27d3caf225eee5.jpg', type: 'destino' },
        { id: 'dest-iruya', title: 'Iruya', subtitle: 'Pueblo mágico en la montaña', image: '/images/images (1).jpeg', type: 'destino' },
        { id: 'dest-yala-y-termas', title: 'Yala y Termas', subtitle: 'Lagunas y aguas termales', image: '/images/images (2).jpeg', type: 'destino' },
        { id: 'dest-humahuaca', title: 'Humahuaca', subtitle: 'Quebrada e Independencia', image: '/images/purmamarca-jujuy-2.jpg', type: 'destino' },
        { id: 'service-aeropuerto', title: 'Aeropuerto Jujuy', subtitle: 'Traslado privado puerta a puerta', image: 'https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&q=80&w=200', type: 'servicio' },
        { id: 'service-urbano', title: 'Traslado Urbano', subtitle: 'Centro, Terminal, Trámites', image: '/images/centro-real.jpg', type: 'servicio' },
        { id: 'service-urbano', title: 'Shopping', subtitle: 'Compras y traslados', image: '/images/shopping-real.jpg', type: 'servicio' },
    ];

    function toggleSuggestions(show: boolean) {
        if (!suggestionsContainer) return;
        if (show) {
            suggestionsContainer.classList.remove('hidden', 'opacity-0', 'translate-y-2');
            suggestionsContainer.classList.add('block', 'opacity-100', 'translate-y-0');
        } else {
            suggestionsContainer.classList.add('hidden', 'opacity-0', 'translate-y-2');
            suggestionsContainer.classList.remove('block', 'opacity-100', 'translate-y-0');
        }
    }

    function renderSuggestions(matches: Suggestion[]) {
        if (!suggestionsList) return;
        suggestionsList.innerHTML = '';

        if (matches.length === 0) {
            suggestionsList.innerHTML = `
                <div class="p-4 text-center text-gray-500 text-sm">
                    No encontramos resultados. <br>
                    <span class="text-xs">¡Presioná la lupa para consultar por WhatsApp!</span>
                </div>
            `;
            return;
        }

        matches.forEach(item => {
            const div = document.createElement('div');
            div.className = 'flex items-center gap-4 p-3 hover:bg-gray-50 rounded-2xl cursor-pointer transition-colors group';
            div.innerHTML = `
                <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0 border border-gray-100">
                    <img src="${item.image}" class="w-full h-full object-cover group-hover:scale-110 transition-transform" alt="${item.title}">
                </div>
                <div class="flex-1">
                    <h4 class="font-bold text-gray-900 text-sm group-hover:text-brand-blue">${item.title}</h4>
                    <p class="text-xs text-gray-500 font-medium">${item.subtitle}</p>
                </div>
                <div class="text-gray-300 group-hover:text-brand-blue group-hover:translate-x-1 transition-all">
                   <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </div>
            `;
            div.onclick = () => {
                const target = document.getElementById(item.id);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    target.classList.add('ring-4', 'ring-jujuy-sun', 'transition-all', 'duration-500');
                    setTimeout(() => target.classList.remove('ring-4', 'ring-jujuy-sun'), 2000);
                    toggleSuggestions(false);
                    searchInput.value = item.title;
                }
            };
            suggestionsList.appendChild(div);
        });
    }

    searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        if (query.length > 0) {
            const matches = suggestionsData.filter(item => 
                item.title.toLowerCase().includes(query) || 
                item.subtitle.toLowerCase().includes(query)
            );
            renderSuggestions(matches);
            toggleSuggestions(true);
        } else {
            toggleSuggestions(false);
        }
    });

    // Close suggestions when clicking outside
    document.addEventListener('click', (e) => {
        if (!searchInput?.contains(e.target as Node) && !suggestionsContainer?.contains(e.target as Node)) {
            toggleSuggestions(false);
        }
    });

    // Original search logic for button click (WhatsApp fallback)
    searchBtn?.addEventListener('click', () => {
         const query = searchInput?.value.trim();
        if (query) {
            const message = `Hola, vi tu sitio web. Quiero ir a: ${query}`;
            const whatsappUrl = `https://wa.me/5493884376850?text=${encodeURIComponent(message)}`;
            window.open(whatsappUrl, '_blank');
        }
    });

    searchInput?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
             const query = searchInput?.value.trim();
             if (query) {
                 // Try simple filter logic first just in case they hit enter on a partial match
                 const match = suggestionsData.find(item => item.title.toLowerCase().includes(query.toLowerCase()));
                 if (match) {
                     document.getElementById(match.id)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                     toggleSuggestions(false);
                 } else {
                     searchBtn?.click();
                 }
             }
        }
    });
</script>
