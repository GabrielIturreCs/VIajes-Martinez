---
---
<section id="servicios" class="py-24 bg-gray-50 relative overflow-hidden font-outfit">
    <!-- Abstract Background Shape -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-[600px] h-[600px] bg-gradient-to-br from-brand-blue/5 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-[600px] h-[600px] bg-gradient-to-tr from-jujuy-sun/10 to-transparent rounded-full blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Header & Search -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-8">
            <div data-aos="fade-right">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-bold uppercase tracking-wider mb-4 border border-blue-100">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue"></span>
                    </span>
                    Servicio Local exclusivo
                </div>
                <h2 class="text-4xl md:text-5xl font-black text-gray-900 leading-tight">
                    MOVILIDAD <span class="text-brand-blue">PREMIUM</span> <br>
                    PARA JUJEÑOS
                </h2>
            </div>

            <!-- Search Bar -->
            <div class="w-full md:w-auto" data-aos="fade-left">
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 group-hover:text-brand-blue transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input type="text" placeholder="Buscar destino o servicio..." class="w-full md:w-80 pl-11 pr-4 py-4 rounded-2xl bg-white border border-gray-100 shadow-lg shadow-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-blue/20 focus:border-brand-blue text-sm font-medium text-gray-900 placeholder:text-gray-500 transition-all" />
                </div>
            </div>
        </div>

        <!-- Bento Grid Layout -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            
            <!-- Card 1: Urbano (Large - 7 cols) with SLIDER -->
            <div class="md:col-span-7 bg-white rounded-[2.5rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] border border-gray-200 relative overflow-hidden group hover:border-brand-blue/30 transition-all duration-300 flex flex-col" data-aos="fade-up">
                <!-- Header part -->
                <div class="relative z-10 mb-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-brand-blue shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M14 17H9"/></svg>
                        </div>
                        <div>
                            <h3 class="text-3xl font-black text-gray-900 leading-none">Traslados Urbanos</h3>
                            <p class="text-gray-500 font-medium text-xs mt-1">Elegí tu destino frecuente</p>
                        </div>
                    </div>
                    
                    <!-- Chips -->
                    <div class="flex flex-wrap gap-2">
                         <span class="px-3 py-1 bg-gray-50 rounded-lg text-[10px] font-bold text-gray-600 border border-gray-100 flex items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Seguro
                        </span>
                        <span class="px-3 py-1 bg-gray-50 rounded-lg text-[10px] font-bold text-gray-600 border border-gray-100 flex items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg> Puntual
                        </span>
                    </div>
                </div>

                <!-- Internal Slider of Places -->
                <div class="relative flex-1 min-h-[200px] mb-6 -mx-4 px-4 overflow-x-auto pb-4 scrollbar-hide flex gap-4 snap-x">
                    
                    <!-- Slide 1: Centro -->
                    <div class="min-w-[160px] h-[200px] rounded-3xl relative overflow-hidden bg-gray-900 snap-center cursor-pointer group/card hover:scale-[1.02] transition-transform">
                        <img src="/images/centro-real.jpg" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover/card:opacity-100 transition-opacity" alt="Centro">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                        <div class="absolute top-3 right-3 bg-brand-blue text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-lg">
                            $4.500
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <p class="text-[10px] text-gray-300 font-bold uppercase tracking-wider mb-1">Trámites</p>
                            <h4 class="text-white font-bold text-lg leading-none">Centro</h4>
                        </div>
                    </div>

                    <!-- Slide 2: Terminal -->
                    <div class="min-w-[160px] h-[200px] rounded-3xl relative overflow-hidden bg-gray-900 snap-center cursor-pointer group/card hover:scale-[1.02] transition-transform">
                        <img src="/images/terminal-real.jpg" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover/card:opacity-100 transition-opacity" alt="Terminal">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                         <div class="absolute top-3 right-3 bg-brand-blue text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-lg">
                            $5.500
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <p class="text-[10px] text-gray-300 font-bold uppercase tracking-wider mb-1">Viajes</p>
                            <h4 class="text-white font-bold text-lg leading-none">Terminal</h4>
                        </div>
                    </div>

                    <!-- Slide 3: Shopping -->
                    <div class="min-w-[160px] h-[200px] rounded-3xl relative overflow-hidden bg-gray-900 snap-center cursor-pointer group/card hover:scale-[1.02] transition-transform">
                        <img src="/images/shopping-real.jpg" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover/card:opacity-100 transition-opacity" alt="Shopping">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                         <div class="absolute top-3 right-3 bg-brand-blue text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-lg">
                            $6.000
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <p class="text-[10px] text-gray-300 font-bold uppercase tracking-wider mb-1">Compras</p>
                            <h4 class="text-white font-bold text-lg leading-none">Shopping</h4>
                        </div>
                    </div>

                    <!-- Slide 4: Ciudad Cultural -->
                    <div class="min-w-[160px] h-[200px] rounded-3xl relative overflow-hidden bg-gray-900 snap-center cursor-pointer group/card hover:scale-[1.02] transition-transform">
                        <img src="/images/cultural.png" class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover/card:opacity-100 transition-opacity" alt="Eventos">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                         <div class="absolute top-3 right-3 bg-brand-blue text-white text-[10px] font-bold px-2 py-1 rounded-md shadow-lg">
                            $5.000
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <p class="text-[10px] text-gray-300 font-bold uppercase tracking-wider mb-1">Eventos</p>
                            <h4 class="text-white font-bold text-lg leading-tight">Ciudad Cultural</h4>
                        </div>
                    </div>

                </div>

                <div class="flex items-center justify-between border-t border-gray-100 pt-4 mt-auto">
                    <div>
                        <span class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TARIFA PLANA DESDE</span>
                        <div class="flex items-baseline gap-1">
                            <span class="text-3xl font-black text-brand-blue">$5.000</span>
                        </div>
                    </div>
                    <a href="https://wa.me/5493884376850?text=Hola,%20vi%20tu%20sitio%20web%20hecho%20por%20Gabriel.%20Necesito%20un%20remis%20ahora." target="_blank" class="px-6 py-3 bg-gray-900 text-white rounded-2xl font-bold hover:bg-brand-blue transition-all shadow-lg hover:shadow-brand-blue/30 flex items-center gap-2 transform active:scale-95 group">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-white group-hover:text-black transition-colors"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884 10.01 10.01 0 0 1-13.3-3.41 10.01 10.01 0 0 1 3.41-13.3 10.01 10.01 0 0 1 13.3 3.41c.88 1.45 1.34 3.12 1.34 4.83 0 5.45-4.437 9.884-9.885 9.884"/></svg>
                        Pedir Remís
                    </a>
                </div>
            </div>

            <!-- Card 2: Aeropuerto (Tall - 5 cols) -->
            <div class="md:col-span-5 bg-brand-blue rounded-[2.5rem] p-8 md:p-10 text-white relative overflow-hidden shadow-2xl shadow-brand-blue/20 group hover:-translate-y-1 transition-transform cursor-pointer" data-aos="fade-up" data-aos-delay="100">
                <!-- Artistic Background -->
                <div class="absolute inset-0 bg-[url('/images/noise.png')] opacity-10 mix-blend-overlay"></div>
                
                <!-- Decorative Plane Path -->
                <svg class="absolute top-12 right-0 w-full opacity-20" viewBox="0 0 200 100" preserveAspectRatio="none">
                     <path d="M0,80 Q100,20 200,40" fill="none" stroke="white" stroke-width="2" stroke-dasharray="8,8" class="animate-pulse"/>
                </svg>

                <div class="relative z-10 flex flex-col h-full justify-between">
                    <div>
                        <div class="w-16 h-16 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center mb-6 border border-white/20 text-jujuy-sun shadow-inner-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <h3 class="text-3xl font-black mb-2 tracking-tight">Aeropuerto</h3>
                        <p class="text-blue-100 font-medium opacity-80 mb-8 leading-relaxed">Olvidate de esperar. Servicio VIP puerta a puerta.</p>
                        
                        <div class="space-y-3">
                            <div class="flex items-center gap-3 bg-white/5 p-3 rounded-2xl border border-white/5 backdrop-blur-sm">
                                <div class="w-8 h-8 rounded-full bg-jujuy-sun/20 flex items-center justify-center text-jujuy-sun font-bold text-xs">24h</div>
                                <span class="text-sm font-medium">Disponibilidad Total</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-white/10">
                         <div class="flex justify-between items-end mb-4">
                             <span class="text-[10px] font-bold uppercase tracking-widest text-blue-200 mb-1">PRECIO FINAL</span>
                             <span class="text-4xl font-black text-white tracking-tight">$25.000</span>
                         </div>
                         <a href="https://wa.me/5493884376850?text=Hola,%20vi%20tu%20sitio%20web%20hecho%20por%20Gabriel.%20Quiero%20reservar%20aeropuerto." target="_blank" class="block w-full text-center py-4 bg-white text-brand-blue font-black tracking-wide rounded-2xl hover:bg-jujuy-sun hover:text-black transition-all shadow-lg transform active:scale-95 flex items-center justify-center gap-2">
                             <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884 10.01 10.01 0 0 1-13.3-3.41 10.01 10.01 0 0 1 3.41-13.3 10.01 10.01 0 0 1 13.3 3.41c.88 1.45 1.34 3.12 1.34 4.83 0 5.45-4.437 9.884-9.885 9.884"/></svg>
                            RESERVAR
                         </a>
                    </div>
                </div>
            </div>

            <!-- Card 3: Envíos, Card 4: Seguridad, Card 5: Pagos -->
            <div class="md:col-span-4 bg-jujuy-sun rounded-[2.5rem] p-8 flex flex-col justify-between shadow-xl shadow-jujuy-sun/20 group hover:scale-[1.02] transition-transform relative overflow-hidden" data-aos="fade-up" data-aos-delay="200">
                <div class="absolute -right-6 -bottom-6 opacity-20 rotate-[-15deg]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <div class="relative z-10 mb-4">
                    <span class="bg-black text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-4 inline-block shadow-md">NUEVO</span>
                    <h3 class="text-3xl font-black text-black leading-none mb-2">Envíos Flash</h3>
                    <p class="text-black/70 font-bold text-sm leading-tight">Te llevamos paquetes, llaves o lo que te olvidaste.</p>
                </div>
                <div class="relative z-10 mt-4">
                     <a href="https://wa.me/5493884376850?text=Hola,%20vi%20tu%20sitio%20web%20hecho%20por%20Gabriel.%20Necesito%20un%20envio." target="_blank" class="inline-flex items-center gap-2 bg-black/5 hover:bg-black/10 px-4 py-2 rounded-xl text-black font-black text-sm transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884 10.01 10.01 0 0 1-13.3-3.41 10.01 10.01 0 0 1 3.41-13.3 10.01 10.01 0 0 1 13.3 3.41c.88 1.45 1.34 3.12 1.34 4.83 0 5.45-4.437 9.884-9.885 9.884"/></svg>
                        CONSULTAR
                     </a>
                </div>
            </div>
            
            <div class="md:col-span-4 bg-white rounded-[2.5rem] p-8 border border-gray-100 shadow-lg flex flex-col justify-center items-center text-center group hover:border-green-500 transition-colors relative overflow-hidden" data-aos="fade-up" data-aos-delay="300">
                <div class="absolute inset-0 bg-green-50/50 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center text-green-600 mb-4 group-hover:scale-110 transition-transform relative z-10 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div class="relative z-10">
                    <h4 class="font-black text-gray-900 text-lg mb-1">Seguridad Total</h4>
                    <p class="text-xs text-gray-500 font-medium px-4">Monitoreo satelital y seguro de pasajeros incluido en cada viaje.</p>
                </div>
            </div>

            <div class="md:col-span-4 bg-gray-900 rounded-[2.5rem] p-8 flex flex-col justify-center items-center text-center text-white shadow-lg relative overflow-hidden" data-aos="fade-up" data-aos-delay="400">
                <div class="absolute inset-0 opacity-20" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, #333 10px, #333 20px);"></div>
                <div class="relative z-10 w-full">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-6 border-b border-gray-800 pb-2">MEDIOS DE PAGO</p>
                    <div class="flex justify-center gap-6 text-3xl mb-4">
                        <span>💵</span> <span>💳</span> <span>📱</span>
                    </div>
                    <div class="bg-gray-800/50 rounded-lg py-1 px-3 inline-block">
                        <p class="text-[10px] font-bold text-gray-300">Mercado Pago / Ualá</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .shadow-inner-white {
        box-shadow: inset 0 0 20px rgba(255,255,255,0.1);
    }
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
