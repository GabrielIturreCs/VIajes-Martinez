---
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "Tu remisero amigo en Jujuy. Viajes seguros, locales y turísticos con Víctor Martínez." } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        
        <!-- Google Fonts: Outfit (Headings) & Inter (Body) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Outfit:wght@400;700;900&display=swap" rel="stylesheet">

        <!-- AOS for Animations (Legacy support) -->
        <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
        
        <!-- Lenis for Smooth Scroll -->
        <style>
            html.lenis, html.lenis body {
              height: auto;
            }
            .lenis.lenis-smooth {
              scroll-behavior: auto !important;
            }
            .lenis.lenis-smooth [data-lenis-prevent] {
              overscroll-behavior: contain;
            }
            .lenis.lenis-stopped {
              overflow: hidden;
            }
            .lenis.lenis-scrolling iframe {
              pointer-events: none;
            }
        </style>

		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-white font-inter overflow-x-hidden selection:bg-jujuy-sun selection:text-black">
		<slot />
        
        <!-- Libraries -->
        <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
        <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.29/dist/lenis.min.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
        
        <script is:inline>
            // --- 1. Initialize Lenis (Smooth Scroll) ---
            document.addEventListener('DOMContentLoaded', () => {
                if (typeof Lenis !== 'undefined') {
                    const lenis = new Lenis({
                        duration: 1.2,
                        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                        direction: 'vertical',
                        gestureDirection: 'vertical',
                        smooth: true,
                        mouseMultiplier: 1,
                        smoothTouch: false,
                        touchMultiplier: 2,
                    });

                    function raf(time) {
                        lenis.raf(time);
                        requestAnimationFrame(raf);
                    }
                    requestAnimationFrame(raf);

                    // Connect Lenis to ScrollTrigger if available
                    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
                        gsap.registerPlugin(ScrollTrigger);
                        lenis.on('scroll', ScrollTrigger.update);
                        gsap.ticker.add((time)=>{
                          lenis.raf(time * 1000);
                        });
                        gsap.ticker.lagSmoothing(0);
                    }
                } else {
                    console.warn('Lenis not loaded');
                    document.documentElement.style.scrollBehavior = 'smooth';
                }
            });

            // --- 2. Initialize AOS (Legacy/Simple animations) ---
            AOS.init({
                duration: 1000,
                once: true,
                offset: 50,
                easing: 'ease-out-cubic',
            });

            // --- 3. Initialize VanillaTilt (3D Tilt) ---
            document.addEventListener('DOMContentLoaded', () => {
                const tiltElements = document.querySelectorAll('[data-tilt]');
                if (window.VanillaTilt) {
                   VanillaTilt.init(tiltElements, {
                        max: 8, // Increased for more impact
                        speed: 1000, // Slower return for "heavy" feel
                        scale: 1.02,
                        glare: true,
                        "max-glare": 0.1,
                        gyroscope: true,
                   });
                }
                
                // --- 4. GSAP Advanced Animations ---
                
                // 4a. Reveal Text Animation (Split effect simulation)
                const revealElements = document.querySelectorAll('.reveal-text');
                revealElements.forEach(element => {
                    gsap.fromTo(element, 
                        { y: 50, opacity: 0, scale: 0.95 },
                        {
                            scrollTrigger: {
                                trigger: element,
                                start: "top 85%",
                                toggleActions: "play none none reverse"
                            },
                            y: 0,
                            opacity: 1,
                            scale: 1,
                            duration: 1.2,
                            ease: "power3.out"
                        }
                    );
                });

                // 4b. Parallax Images on Scroll
                const parallaxImages = document.querySelectorAll('.parallax-img-container img');
                parallaxImages.forEach(img => {
                    gsap.to(img, {
                        yPercent: 20,
                        ease: "none",
                        scrollTrigger: {
                            trigger: img.parentElement,
                            start: "top bottom",
                            end: "bottom top",
                            scrub: true
                        } 
                    });
                });
            });

            // --- 5. Mouse Parallax (Floating Elements) ---
            document.addEventListener('mousemove', (e) => {
                const shapes = document.querySelectorAll('.mouse-parallax');
                const x = e.clientX / window.innerWidth;
                const y = e.clientY / window.innerHeight;

                shapes.forEach(shape => {
                    const speed = shape.getAttribute('data-speed') || 20;
                    const xOffset = (window.innerWidth / 2 - e.clientX) / speed;
                    const yOffset = (window.innerHeight / 2 - e.clientY) / speed;
                    
                    // Simple lerp for smoother follow could be added here, but direct transform is snappy
                    shape.style.transform = `translate(${xOffset}px, ${yOffset}px)`;
                });
            });
        </script>
	</body>
</html>

<style is:global>
    h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
    }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        background: #1a1a1a;
    }
    ::-webkit-scrollbar-thumb {
        background: #FFE135;
        border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #e6cc00;
    }
</style>
